@model PimEstoque.Services.DashboardStats

@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header mb-4">
    <h1 class="display-6 fw-bold">
        <i class="fas fa-chart-line text-primary me-2"></i>Dashboard
    </h1>
    <p class="text-muted">Visão geral do sistema de controle de estoque</p>
</div>

<div class="row">
    <!-- Card: Total de Produtos -->
    <div class="col-md-6 col-lg-3 mb-4">
        <div class="card border-left-primary shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted text-uppercase fw-bold mb-1">
                            <i class="fas fa-cube me-2"></i>Total de Produtos
                        </p>
                        <h3 class="text-primary fw-bold">@Model.TotalProdutos</h3>
                    </div>
                    <div class="text-primary opacity-50 display-5">
                        <i class="fas fa-cube"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card: Total de Categorias -->
    <div class="col-md-6 col-lg-3 mb-4">
        <div class="card border-left-success shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted text-uppercase fw-bold mb-1">
                            <i class="fas fa-tags me-2"></i>Categorias
                        </p>
                        <h3 class="text-success fw-bold">@Model.TotalCategorias</h3>
                    </div>
                    <div class="text-success opacity-50 display-5">
                        <i class="fas fa-tags"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card: Produtos em Baixa -->
    <div class="col-md-6 col-lg-3 mb-4">
        <div class="card border-left-warning shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted text-uppercase fw-bold mb-1">
                            <i class="fas fa-exclamation-triangle me-2"></i>Itens em Baixa
                        </p>
                        <h3 class="text-warning fw-bold">@Model.ProdutosEmBaixa</h3>
                    </div>
                    <div class="text-warning opacity-50 display-5">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card: Última Atualização -->
    <div class="col-md-6 col-lg-3 mb-4">
        <div class="card border-left-info shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted text-uppercase fw-bold mb-1">
                            <i class="fas fa-clock me-2"></i>Última Atualização
                        </p>
                        <h6 class="text-info fw-bold">@Model.UltimaAtualizacao.ToString("dd/MM/yyyy HH:mm")</h6>
                    </div>
                    <div class="text-info opacity-50 display-5">
                        <i class="fas fa-clock"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-5">
    <!-- Seção de Gráficos (Placeholder para futuro) -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Distribuição por Categoria</h5>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center" style="height: 300px;">
                <div class="text-center text-muted">
                    <i class="fas fa-chart-bar display-1 mb-3"></i>
                    <p>Gráfico será carregado aqui</p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-success text-white py-3">
                <h5 class="mb-0"><i class="fas fa-chart-pie me-2"></i>Status do Estoque</h5>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center" style="height: 300px;">
                <div class="text-center text-muted">
                    <i class="fas fa-chart-pie display-1 mb-3"></i>
                    <p>Gráfico será carregado aqui</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-5">
    <div class="col-12">
        <a href="/ProdutosView" class="btn btn-primary btn-lg">
            <i class="fas fa-arrow-right me-2"></i>Ir para Produtos
        </a>
    </div>
</div>
