@model Produto

@{
    ViewData["Title"] = "Editar Produto";
}

<div class="page-header mb-4">
    <h1 class="display-6 fw-bold">
        <i class="fas fa-edit text-warning me-2"></i>@ViewData["Title"]
    </h1>
    <p class="text-muted">Atualize as informações do produto selecionado</p>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark py-3">
                <h5 class="mb-0"><i class="fas fa-form me-2"></i>Formulário de Edição</h5>
            </div>
            <div class="card-body p-4">
                <form method="post" asp-action="Edit">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            <strong>Erro na validação!</strong>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <input type="hidden" name="Id" value="@Model.Id">

                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted">
                            <i class="fas fa-key me-2"></i>ID do Produto
                        </label>
                        <div class="form-control bg-light" disabled>
                            <strong>@Model.Id</strong>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="PartNumber" class="form-label fw-bold">
                            <i class="fas fa-barcode me-2 text-primary"></i>Part Number
                        </label>
                        <input type="text" class="form-control" id="PartNumber" name="PartNumber" 
                               value="@Model.PartNumber" required>
                        <small class="text-muted">Código único do produto</small>
                    </div>

                    <div class="mb-3">
                        <label for="NomeProduto" class="form-label fw-bold">
                            <i class="fas fa-tag me-2 text-primary"></i>Nome do Produto
                        </label>
                        <input type="text" class="form-control" id="NomeProduto" name="NomeProduto" 
                               value="@Model.NomeProduto" required>
                        <small class="text-muted">Nome descritivo do produto</small>
                    </div>

                    <div class="mb-4">
                        <label for="Categoria" class="form-label fw-bold">
                            <i class="fas fa-list me-2 text-primary"></i>Categoria
                        </label>
                        <select class="form-control" id="Categoria" name="Categoria" required>
                            <option value="">-- Selecione uma categoria --</option>
                            <option value="Eletrônicos">Eletrônicos</option>
                            <option value="Periféricos">Periféricos</option>
                            <option value="Software">Software</option>
                            <option value="Acessórios">Acessórios</option>
                            <option value="Outros">Outros</option>
                        </select>
                        <small class="text-muted">Categoria do produto</small>
                    </div>

                    <script>
                        document.getElementById('Categoria').value = '@Model.Categoria';
                    </script>

                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-between">
                        <button type="submit" class="btn btn-warning btn-lg">
                            <i class="fas fa-save me-2"></i>Atualizar Produto
                        </button>
                        <a href="/ProdutosView" class="btn btn-secondary btn-lg">
                            <i class="fas fa-times me-2"></i>Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm bg-light">
            <div class="card-header bg-info text-white py-3">
                <h5 class="mb-0"><i class="fas fa-lightbulb me-2"></i>Informações</h5>
            </div>
            <div class="card-body">
                <p class="mb-2">
                    <strong class="d-block mb-1"><i class="fas fa-info-circle text-info me-2"></i>ID do Produto</strong>
                    <small class="text-muted">@Model.Id</small>
                </p>
                <hr>
                <p class="mb-0">
                    <strong class="d-block mb-1"><i class="fas fa-lightbulb text-warning me-2"></i>Dica</strong>
                    <small class="text-muted">Todos os campos marcados com * são obrigatórios</small>
                </p>
            </div>
        </div>
    </div>
</div>
