@model Produto

@{
    ViewData["Title"] = "Deletar Produto";
}

<div class="page-header mb-4">
    <h1 class="display-6 fw-bold">
        <i class="fas fa-trash text-danger me-2"></i>@ViewData["Title"]
    </h1>
    <p class="text-muted">Confirme a exclusão do produto</p>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Confirmação de Exclusão</h5>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-warning" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <strong>Atenção!</strong> Esta ação é irreversível. Tem certeza que deseja deletar este produto?
                </div>

                <div class="card bg-light mb-4">
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="fw-bold text-muted">
                                <i class="fas fa-key me-2"></i>ID
                            </label>
                            <p>@Model.Id</p>
                        </div>
                        <div class="mb-3">
                            <label class="fw-bold text-muted">
                                <i class="fas fa-barcode me-2"></i>Part Number
                            </label>
                            <p>@Model.PartNumber</p>
                        </div>
                        <div class="mb-3">
                            <label class="fw-bold text-muted">
                                <i class="fas fa-tag me-2"></i>Nome do Produto
                            </label>
                            <p>@Model.NomeProduto</p>
                        </div>
                        <div>
                            <label class="fw-bold text-muted">
                                <i class="fas fa-list me-2"></i>Categoria
                            </label>
                            <p><span class="badge bg-info">@Model.Categoria</span></p>
                        </div>
                    </div>
                </div>

                <form method="post" asp-action="DeleteConfirmed">
                    <input type="hidden" name="Id" value="@Model.Id">
                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-between">
                        <button type="submit" class="btn btn-danger btn-lg">
                            <i class="fas fa-trash me-2"></i>Sim, Deletar
                        </button>
                        <a href="/ProdutosView" class="btn btn-secondary btn-lg">
                            <i class="fas fa-times me-2"></i>Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
